###############################################################################
# 預設行為：自動正規化行尾符號
###############################################################################
* text=auto

###############################################################################
# 程式碼檔案：明確標記為文字
###############################################################################
*.cs        text diff=csharp
*.cpp       text diff=cpp
*.h         text diff=cpp
*.hpp       text diff=cpp
*.c         text diff=c
# XAML / XML: UTF-8, no BOM
*.xaml      text
*.xml       text
*.json      text
*.props     text
*.targets   text
*.sln       text eol=crlf
*.csproj    text eol=crlf
*.vcxproj   text eol=crlf
*.def       text

###############################################################################
# 二進位檔案
###############################################################################
*.snk       binary
*.ico       binary
*.png       binary
*.jpg       binary
*.gif       binary
*.dll       binary
*.exe       binary
*.7z        binary
