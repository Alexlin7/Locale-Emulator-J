<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>14</LangVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)key.snk</AssemblyOriginatorKeyFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- 全球化後端使用 Windows NLS（與原版 .NET Framework 4.0 的 Locale Emulator 一致）。
       .NET 10 預設的 ICU 模式下，CultureInfo.GetCultures 列出的是 zh-Hans-CN / zh-Hant-TW 等名稱，
       其 LCID 為 0x1000（LOCALE_CUSTOM_UNSPECIFIED），選了之後 Core 無法模擬、程序完全沒反應；
       zh-CN / zh-TW / zh-HK 只在 NLS 模式下出現在清單中。
       Core 直接操作 NLS 表，不受此設定影響。驗證：tests/LECommonLibrary.Tests/RegionSupportTests.cs -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
  </ItemGroup>
</Project>
