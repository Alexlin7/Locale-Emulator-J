// src/LEInstaller/LEInstaller.rc
#include <winres.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// Same icon as LEGUI.
1 ICON "..\\LEGUI\\icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 3,0,0,0
 PRODUCTVERSION 3,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Locale Emulator Setup"
            VALUE "FileVersion", "3.0.0.0"
            VALUE "InternalName", "LEInstaller"
            VALUE "LegalCopyright", "LGPL-3.0"
            VALUE "OriginalFilename", "LEInstaller.exe"
            VALUE "ProductName", "Locale Emulator"
            VALUE "ProductVersion", "3.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
