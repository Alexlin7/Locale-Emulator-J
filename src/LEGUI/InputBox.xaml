<Window x:Class="LEGUI.InputBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ResizeMode="NoResize" SizeToContent="Height" Width="360"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=tbText}"
        Loaded="Window_Loaded">
    <!-- Content sizes the window: no hard-coded margins, so the text box is never clipped. -->
    <Grid Margin="16" TextElement.FontFamily="{DynamicResource UIFont}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label x:Name="lText" Grid.Row="0" Padding="0" Margin="0,0,0,6"
               FontFamily="{DynamicResource UIFont}" />
        <TextBox x:Name="tbText" Grid.Row="1" Padding="4,3" VerticalContentAlignment="Center"
                 FontFamily="{DynamicResource UIFont}" TextChanged="tbText_TextChanged" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="bOk" Content="{DynamicResource Ok}" MinWidth="80" Padding="12,3"
                    IsDefault="True" IsEnabled="False" Click="bOk_Click" />
            <Button x:Name="bCancel" Content="{DynamicResource Cancel}" MinWidth="80" Padding="12,3"
                    Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
