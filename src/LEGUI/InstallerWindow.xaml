<Window x:Class="LEGUI.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:legui="clr-namespace:LEGUI"
        SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <!-- Installer mode (LEGUI.exe with the installer switch, started by LEInstaller.exe):
         the Shell Extension panel, plus importing an old LEConfig.xml. -->
    <StackPanel Margin="12" TextElement.FontFamily="{DynamicResource UIFont}">
        <legui:ShellExtensionPanel x:Name="shellExtPanel" />
        <!-- Always available, also when the original LE's registration is already gone
             (then the panel shows no cleanup / import section). -->
        <GroupBox Header="{DynamicResource TabProfile}" Margin="8,4">
            <Button x:Name="bImportProfiles" Content="{DynamicResource ImportProfiles}"
                    HorizontalAlignment="Left" MinWidth="120" Margin="8"
                    Click="bImportProfiles_Click" />
        </GroupBox>
    </StackPanel>
</Window>
