; ntdll.dll exports that the Windows SDK's ntdll.lib does not provide.
; Built into ntdll_ex.lib by Core.props (x86 only).
;
; Syntax notes for x86 import libraries generated by lib.exe:
;   - Plain names are __cdecl; lib.exe adds the leading underscore to the
;     linker symbol and imports the name as written.
;   - __stdcall functions are listed as "Name@N" (N = argument bytes) and MUST
;     use "EXPORTAS Name", otherwise the import name keeps the "@N" suffix and
;     the DLL fails to load.
;   - "Symbol EXPORTAS RealName" also maps a CRT name the headers use to the
;     name ntdll actually exports.
LIBRARY ntdll.dll
EXPORTS
    ; Undocumented loader APIs (__stdcall)
    LdrInitializeThunk@8                    EXPORTAS LdrInitializeThunk
    LdrRegisterDllNotification@16           EXPORTAS LdrRegisterDllNotification
    LdrUnregisterDllNotification@4          EXPORTAS LdrUnregisterDllNotification

    ; NLS conversion (__stdcall)
    RtlUpcaseUnicodeStringToAnsiString@12   EXPORTAS RtlUpcaseUnicodeStringToAnsiString

    ; Compiler helpers (64-bit arithmetic, stack probe, float conversion)
    _alldiv
    _allmul
    _allrem
    _allshl
    _allshr
    _aulldiv
    _aullrem
    _aullshr
    _chkstk
    _alloca_probe
    _ftol
    _ftol2
    _ftol2_sse

    ; SEH handler used by __try/__except (wrapped by Runtime\CoreRuntime.cpp)
    _except_handler4_common

    ; C runtime functions
    memcmp
    memcpy
    memmove
    memset
    strlen
    wcslen
    wcsstr
    _stricmp
    _wcsicmp
    wcsicmp                                 EXPORTAS _wcsicmp
    _snwprintf
    _vsnprintf
    _vsnwprintf
    _vscwprintf
    swprintf
    ; The UCRT's C++ swprintf(buffer, format, ...) overload calls the standard
    ; vswprintf(buffer, INT_MAX, format, args); ntdll has no vswprintf, but
    ; _vsnwprintf has the same signature and behaves identically for an INT_MAX count.
    vswprintf                               EXPORTAS _vsnwprintf
